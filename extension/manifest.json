{
    "manifest_version": 3,
    "name": "Simple email tracker for Gmail",
    "version": "1.0",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "description": "Simple email tracker for Gmail",
    "content_scripts": [
        {
            "matches": [ "*://mail.google.com/*" ],
            "js": [
                "extensionInjector.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [{
        "resources": [
            "extensionInjector.js",
            "extensionInjector.js.map",
            "gmailJsLoader.js",
            "gmailJsLoader.js.map",
            "extension.js",
            "extension.js.map"
        ],
        "matches": ["<all_urls>"]
    }],
    "host_permissions": [
        "https://*/*"
    ]
}
