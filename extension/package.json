{
  "name": "gmailjs-node-boilerplate",
  "version": "1.1.0",
  "description": "",
  "main": "",
  "scripts": {
    "stage": "mkdir dist 2>nul & mkdir dist\\icons 2>nul & copy manifest.json dist\\manifest.json /Y & xcopy icons dist\\icons /E /Y /Q",
    "bundle": "esbuild src/gmailJsLoader.ts src/extension.ts src/extensionInjector.ts --outdir=dist/ --bundle --sourcemap --target=es6",
    "typecheck": "tsc --noEmit",
    "build": "npm run stage && npm run bundle",
    "dev": "npm run stage && npm run bundle -- --watch"
  },
  "author": "Jostein kjønigsen",
  "license": "ISC",
  "dependencies": {
    "gmail-js": "1.1.16",
    "jquery": "4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@types/jquery": "^3.5.33",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3"
  }
}
